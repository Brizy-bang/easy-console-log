{
  "name": "easy-console-log",
  "displayName": "Easy Console Log",
  "description": "%easyConsoleLog.description%",
  "version": "0.2.0",
  "publisher": "Brizy-b",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brizy-bang/easy-console-log.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:json",
    "onLanguage:svelte",
    "onLanguage:python"
  ],
  "contributes": {
    "commands": [
      {
        "command": "easyConsoleLog.insert",
        "title": "%easyConsoleLog.command.insert%"
      },
      {
        "command": "easyConsoleLog.commentAll",
        "title": "%easyConsoleLog.command.commentAll%"
      },
      {
        "command": "easyConsoleLog.uncommentAll",
        "title": "%easyConsoleLog.command.uncommentAll%"
      },
      {
        "command": "easyConsoleLog.deleteAll",
        "title": "%easyConsoleLog.command.deleteAll%"
      },
      {
        "command": "easyConsoleLog.toggleCurrentLog",
        "title": "%easyConsoleLog.command.toggleCurrentLog%"
      },
      {
        "command": "easyConsoleLog.workspace.commentAll",
        "title": "%easyConsoleLog.command.workspace.commentAll%"
      },
      {
        "command": "easyConsoleLog.workspace.uncommentAll",
        "title": "%easyConsoleLog.command.workspace.uncommentAll%"
      },
      {
        "command": "easyConsoleLog.workspace.deleteAll",
        "title": "%easyConsoleLog.command.workspace.deleteAll%"
      },
      {
        "command": "easyConsoleLog.explorer.commentAll",
        "title": "%easyConsoleLog.command.explorer.commentAll%",
        "icon": "$(comment)"
      },
      {
        "command": "easyConsoleLog.explorer.uncommentAll",
        "title": "%easyConsoleLog.command.explorer.uncommentAll%",
        "icon": "$(unfold)"
      },
      {
        "command": "easyConsoleLog.explorer.deleteAll",
        "title": "%easyConsoleLog.command.explorer.deleteAll%",
        "icon": "$(trash)"
      },
      {
        "command": "easyConsoleLog.explorer.refresh",
        "title": "%easyConsoleLog.command.explorer.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "easyConsoleLog.explorer.filter",
        "title": "%easyConsoleLog.command.explorer.filter%",
        "icon": "$(filter)"
      },
      {
        "command": "easyConsoleLog.explorer.toggleItem",
        "title": "%easyConsoleLog.command.explorer.toggleItem%"
      },
      {
        "command": "easyConsoleLog.explorer.deleteItem",
        "title": "%easyConsoleLog.command.explorer.deleteItem%"
      },
      {
        "command": "easyConsoleLog.explorer.copyText",
        "title": "%easyConsoleLog.command.explorer.copyText%"
      }
    ],
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/console-log.code-snippets"
      },
      {
        "language": "typescript",
        "path": "./snippets/console-log.code-snippets"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/console-log.code-snippets"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/console-log.code-snippets"
      },
      {
        "language": "vue",
        "path": "./snippets/console-log.code-snippets"
      },
      {
        "language": "svelte",
        "path": "./snippets/console-log.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easyConsoleLog",
          "title": "%easyConsoleLog.view.container.title%",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "easyConsoleLog": [
        {
          "id": "easyConsoleLog.explorer",
          "name": "%easyConsoleLog.view.explorer.title%",
          "icon": "images/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "easyConsoleLog.explorer.commentAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@1"
        },
        {
          "command": "easyConsoleLog.explorer.uncommentAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@2"
        },
        {
          "command": "easyConsoleLog.explorer.deleteAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@3"
        },
        {
          "command": "easyConsoleLog.explorer.filter",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@4"
        },
        {
          "command": "easyConsoleLog.explorer.refresh",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "easyConsoleLog.explorer.toggleItem",
          "when": "view == easyConsoleLog.explorer && viewItem == logItem",
          "group": "inline@1"
        },
        {
          "command": "easyConsoleLog.explorer.toggleItem",
          "when": "view == easyConsoleLog.explorer && viewItem == logItem.commented",
          "group": "inline@1"
        },
        {
          "command": "easyConsoleLog.explorer.deleteItem",
          "when": "view == easyConsoleLog.explorer && viewItem =~ /^logItem/",
          "group": "inline@2"
        },
        {
          "command": "easyConsoleLog.explorer.copyText",
          "when": "view == easyConsoleLog.explorer && viewItem =~ /^logItem/",
          "group": "inline@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "easyConsoleLog.insert",
        "key": "ctrl+alt+l",
        "mac": "ctrl+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.commentAll",
        "key": "alt+shift+c",
        "mac": "alt+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.uncommentAll",
        "key": "alt+shift+u",
        "mac": "alt+shift+u",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.deleteAll",
        "key": "alt+shift+d",
        "mac": "alt+shift+d",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.toggleCurrentLog",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%easyConsoleLog.configuration.title%",
      "properties": {
        "easyConsoleLog.logMessagePrefix": {
          "type": "string",
          "default": "🪵",
          "description": "%easyConsoleLog.logMessagePrefix.description%"
        },
        "easyConsoleLog.quote": {
          "type": "string",
          "enum": [
            "'",
            "\"",
            "`"
          ],
          "default": "'",
          "description": "%easyConsoleLog.quote.description%"
        },
        "easyConsoleLog.addSemicolon": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.addSemicolon.description%"
        },
        "easyConsoleLog.logFunction": {
          "type": "string",
          "default": "console.log",
          "description": "%easyConsoleLog.logFunction.description%"
        },
        "easyConsoleLog.includeFilename": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.includeFilename.description%"
        },
        "easyConsoleLog.includeLineNumber": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.includeLineNumber.description%"
        },
        "easyConsoleLog.messageTemplate": {
          "type": "string",
          "default": "${prefix} ~ ${location} ~ ${expr}:",
          "description": "%easyConsoleLog.messageTemplate.description%"
        },
        "easyConsoleLog.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.diagnostics.enabled.description%"
        },
        "easyConsoleLog.diagnostics.severity": {
          "type": "string",
          "enum": ["error", "warning", "information", "hint"],
          "default": "information",
          "description": "%easyConsoleLog.diagnostics.severity.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run esbuild-base -- --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "typescript": "~5.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  }
}
