{
  "name": "easy-console-log",
  "displayName": "Easy Console Log",
  "description": "%easyConsoleLog.description%",
  "version": "0.1.4",
  "publisher": "Brizy-b",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brizy-bang/easy-console-log.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "activationEvents": [
    "onCommand:easyConsoleLog.insert",
    "onCommand:easyConsoleLog.commentAll",
    "onCommand:easyConsoleLog.uncommentAll",
    "onCommand:easyConsoleLog.deleteAll",
    "onCommand:easyConsoleLog.explorer.commentAll",
    "onCommand:easyConsoleLog.explorer.uncommentAll",
    "onCommand:easyConsoleLog.explorer.deleteAll",
    "onCommand:easyConsoleLog.explorer.refresh",
    "onView:easyConsoleLog.explorer",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "easyConsoleLog.insert",
        "title": "%easyConsoleLog.command.insert%"
      },
      {
        "command": "easyConsoleLog.commentAll",
        "title": "%easyConsoleLog.command.commentAll%"
      },
      {
        "command": "easyConsoleLog.uncommentAll",
        "title": "%easyConsoleLog.command.uncommentAll%"
      },
      {
        "command": "easyConsoleLog.deleteAll",
        "title": "%easyConsoleLog.command.deleteAll%"
      },
      {
        "command": "easyConsoleLog.explorer.commentAll",
        "title": "%easyConsoleLog.command.explorer.commentAll%",
        "icon": "$(comment)"
      },
      {
        "command": "easyConsoleLog.explorer.uncommentAll",
        "title": "%easyConsoleLog.command.explorer.uncommentAll%",
        "icon": "$(unfold)"
      },
      {
        "command": "easyConsoleLog.explorer.deleteAll",
        "title": "%easyConsoleLog.command.explorer.deleteAll%",
        "icon": "$(trash)"
      },
      {
        "command": "easyConsoleLog.explorer.refresh",
        "title": "%easyConsoleLog.command.explorer.refresh%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "easyConsoleLog",
          "title": "%easyConsoleLog.view.container.title%",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "easyConsoleLog": [
        {
          "id": "easyConsoleLog.explorer",
          "name": "%easyConsoleLog.view.explorer.title%",
          "icon": "images/icon.png"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "easyConsoleLog.explorer.commentAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@1"
        },
        {
          "command": "easyConsoleLog.explorer.uncommentAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@2"
        },
        {
          "command": "easyConsoleLog.explorer.deleteAll",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@3"
        },
        {
          "command": "easyConsoleLog.explorer.refresh",
          "when": "view == easyConsoleLog.explorer",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "easyConsoleLog.insert",
        "key": "ctrl+alt+l",
        "mac": "ctrl+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.commentAll",
        "key": "alt+shift+c",
        "mac": "alt+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.uncommentAll",
        "key": "alt+shift+u",
        "mac": "alt+shift+u",
        "when": "editorTextFocus"
      },
      {
        "command": "easyConsoleLog.deleteAll",
        "key": "alt+shift+d",
        "mac": "alt+shift+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%easyConsoleLog.configuration.title%",
      "properties": {
        "easyConsoleLog.logMessagePrefix": {
          "type": "string",
          "default": "🪵",
          "description": "%easyConsoleLog.logMessagePrefix.description%"
        },
        "easyConsoleLog.quote": {
          "type": "string",
          "enum": [
            "'",
            "\"",
            "`"
          ],
          "default": "'",
          "description": "%easyConsoleLog.quote.description%"
        },
        "easyConsoleLog.addSemicolon": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.addSemicolon.description%"
        },
        "easyConsoleLog.logFunction": {
          "type": "string",
          "default": "console.log",
          "description": "%easyConsoleLog.logFunction.description%"
        },
        "easyConsoleLog.includeFilename": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.includeFilename.description%"
        },
        "easyConsoleLog.includeLineNumber": {
          "type": "boolean",
          "default": true,
          "description": "%easyConsoleLog.includeLineNumber.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run esbuild-base -- --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "typescript": "~5.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0"
  }
}
